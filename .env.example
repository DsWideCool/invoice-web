# 로컬 개발: 이 파일을 .env.local로 복사해 값을 채움
# 배포(Vercel): 이 파일을 .env.vercel로 복사해 배포용 값을 채운 뒤 `npm run env:push`
#   (.env.vercel은 Next.js가 읽지 않고 git에도 올라가지 않음, 빈 값은 건너뜀)
#   관리자 비밀번호는 `npm run hash-password -- --push`로 화면 출력 없이 바로 등록 가능

# Notion 통합 시크릿 키와 견적서 데이터베이스 ID (필수)
NOTION_API_KEY=
NOTION_DATABASE_ID=

# 신고 저장용 Notion 데이터베이스 ID (선택, 미설정 시 신고 기능 비활성화)
# npm run setup:report-db -- <연동에 공유한 Notion 페이지 URL> 로 생성
NOTION_REPORT_DATABASE_ID=

# 관리자 로그인 (배포 권장): npm run hash-password 로 생성한 두 값
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# 관리자 로그인 (로컬 개발용 평문, 8자 이상). ADMIN_PASSWORD_HASH가 있으면 무시됨
ADMIN_PASSWORD=

# 복사되는 견적서 링크의 기준 도메인 (선택, 예: https://invoice.example.com)
# 미설정 시 현재 접속한 도메인을 사용하므로 프리뷰/로컬 주소가 복사될 수 있음
NEXT_PUBLIC_APP_URL=
